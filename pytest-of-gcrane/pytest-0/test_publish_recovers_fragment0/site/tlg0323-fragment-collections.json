      ],
      "context": "Antiatt. p. 90 , 5 : διετίθουν· διετίθεσαν. Ἀντιφῶν (Ἀντιφάνης coni. Meineke Hist. crit. p. 316) Ἰάσονι.",
      "play_title": "ΙΑΣΩΝ",
      "play_work": "iason",
      "play_urn": "urn:cite2:perseus:fragmentaryplays.v1:tlg0323_iason"
