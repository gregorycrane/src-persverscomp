  "fragments": [
    {
      "number": "1",
      "source_id": "tlg1511-fr1",
      "edition": "nauck1889grc1",
      "source_fragment_urn": "urn:cts:greekLit:tlg1511.fragmenta.nauck1889grc1:1",
      "same_as": [],
      "lines": [
        {
          "ref": "1",
          "source_id": "tlg1511-fr1-l1",
          "text": "δεινοὶ γὰρ ἀνδρὶ πάντες ἐσμὲν εὐκλεεῖ"
        },
        {
          "ref": "2",
          "source_id": "tlg1511-fr1-l2",
          "text": "ζῶντι φθονῆσαι, κατθανόντα δ’ αἰνέσαι."
        }
      ],
      "context": "Stob. Flor. 125 , 12 : Μιμνέρμου ἐκ Νεοπτολέμου (sic MA, μιμνέρμου nec plura S) . ‘δεινοὶ — αἰνέσαι’ v. 1 κλεινῷ γὰρ — ἐσμὲν εὔκολοι malit F. G. Schmidt Krit. Stud. 3 p. 27 sq. v. 2 ζῶντι suspectum, cf. Hilberg Princip der Silbenw. p. 216 . intercidisse Mimnermi locum et nomen poetae qui Neoptolemum scripserit coni. Meineke Stob. Flor. 4 p. XXV, cf. Bergk Lyr. 2 p. 33 .",
      "play_title": "ΝΕΟΠΤΟΛΕΜΟΣ",
      "play_work": "neoptolemos",
      "play_urn": "urn:cite2:perseus:fragmentaryplays.v1:tlg1511_neoptolemos"
    },
    {
      "number": "2",
      "source_id": "tlg1511-fr2",
      "edition": "nauck1889grc1",
      "source_fragment_urn": "urn:cts:greekLit:tlg1511.fragmenta.nauck1889grc1:2",
      "same_as": [],
      "lines": [
        {
          "ref": "1",
          "source_id": "tlg1511-fr2-l1",
          "text": ". . οἷα δὴ φιλοῦσιν ἰατροὶ λέγειν,"
        },
        {
          "ref": "2",
          "source_id": "tlg1511-fr2-l2",
          "text": "τὰ φαῦλα μείζω καὶ τὰ δείν’ ὑπὲρ φόβον,"
        },
        {
          "ref": "3",
          "source_id": "tlg1511-fr2-l3",
          "text": "πυργοῦντες αὑτούς"
        }
      ],
      "context": "Stob. Flor. 102 , 3 : Μιμνέρμου κατὰ ἰατρῶν (sic S, κατὰ ἰατρῶν μιμνέρμου νάννου MA) . ‘οἷα — αὑτούς‘ . v. 1 ὁποῖα coni. Bergk. ἰατροὶ Gaisford, οἱ ἰατροὶ SMA. v. 2 ὑπέρφοβα B. v. 3 αὐτοὺς MA, αὐτοί F. G. Schmidt Krit. Stud. 3 p. 28 . Euripidis esse locum coni. Bergk Lyr. 2 p. 33 , Menandro tribuunt Porson et Meineke Com. 4 p. 217 .",
      "play_title": "INCERTAE FABULAE FRAGMENTUM",
      "play_work": "incertae_fabulae_fragmentum",
      "play_urn": "urn:cite2:perseus:fragmentaryplays.v1:tlg1511_incertae_fabulae_fragmentum"
